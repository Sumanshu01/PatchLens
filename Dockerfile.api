
# Multi-stage Dockerfile for PatchLens API & Worker

# =========================
# BUILDER STAGE
# =========================
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        make \
        libcapstone-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        "pyelftools>=0.31" \
        "capstone>=5.0.0" \
        "networkx>=3.2" \
        "scipy>=1.11.0" \
        "fastapi>=0.110.0" \
        "uvicorn>=0.28.0" \
        "pydantic>=2.6.0" \
        "python-multipart>=0.0.9" \
        "sqlalchemy>=2.0.0" \
        "alembic>=1.13.0" \
        "prometheus-client>=0.20.0" \
        "redis>=5.0.0" \
        "rq>=1.16.0" \
        "httpx>=0.27.0"

# =========================
# RUNTIME STAGE
# =========================
FROM python:3.11-slim AS runner

WORKDIR /app

# Install the available Capstone runtime library
RUN apt-get update && \
    if apt-cache show libcapstone5 >/dev/null 2>&1; then \
        CAPSTONE_PKG=libcapstone5; \
    elif apt-cache show libcapstone4 >/dev/null 2>&1; then \
        CAPSTONE_PKG=libcapstone4; \
    else \
        echo "ERROR: No compatible Capstone runtime package found" && exit 1; \
    fi && \
    apt-get install -y --no-install-recommends \
        "$CAPSTONE_PKG" \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application source
COPY core/ /app/core/
COPY api/ /app/api/
COPY corpus/ /app/corpus/
COPY pyproject.toml /app/

# Install PatchLens
RUN pip install --no-cache-dir -e .

# Security hardening
RUN useradd -m -u 10001 appuser && \
    mkdir -p /app/uploads && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

# Health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start API
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
